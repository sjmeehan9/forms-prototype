{
  "manifestVersion": 5,
  "id": "com.forms-prototype.queue-worker",
  "name": "Prototype Queue Worker",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "ID",
      "minVersion": "18.5"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "queueWorkerPanel",
      "label": {
        "default": "Prototype Queue Worker"
      },
      "minimumSize": { "width": 320, "height": 380 },
      "maximumSize": { "width": 1200, "height": 1200 },
      "preferredDockedSize": { "width": 360, "height": 520 },
      "preferredFloatingSize": { "width": 360, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
