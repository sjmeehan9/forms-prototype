    "callout-body": "callout-body",
    "note": "hint"
  },
  "formFields": [
    {
      "name": "member.title",
      "type": "combo",
      "binding": "field:member.title",
      "description": "Title",
      "options": [
        "Mr",
        "Mrs",
        "Ms",
        "Miss",
        "Mx",
        "Dr",
        "Prof"
      ],
      "tabOrder": 1
    },
    {
      "name": "member.lastName",
      "type": "text",
      "binding": "field:member.lastName",
      "description": "Last name",
      "required": true,
      "tabOrder": 2
    },
    {
      "name": "member.firstName",
      "type": "text",
      "binding": "field:member.firstName",
      "description": "First name",
      "required": true,
      "tabOrder": 3
    },
    {
      "name": "address.residential.line1",
      "type": "text",
      "binding": "field:address.residential.line1",
      "description": "Residential street address",
      "required": true,
      "tabOrder": 4
    },
    {
      "name": "address.residential.suburb",
      "type": "text",
      "binding": "field:address.residential.suburb",
      "description": "Residential suburb or town",
      "required": true,
      "tabOrder": 5
    },
    {
      "name": "address.residential.state",
      "type": "text",
      "binding": "field:address.residential.state",
      "description": "Residential state",
      "required": true,
      "tabOrder": 6
    },
    {
      "name": "address.residential.postcode",
      "type": "text",
      "binding": "field:address.residential.postcode",
      "description": "Residential postcode",
      "required": true,
      "tabOrder": 7
    },
    {
      "name": "member.dateOfBirth",
      "type": "text",
      "binding": "field:member.dateOfBirth",
      "description": "Date of birth (DD/MM/YYYY)",
      "required": true,
      "tabOrder": 8
    },
    {
      "name": "member.employeeId",
      "type": "text",
      "binding": "field:member.employeeId",
      "description": "Employee or payroll number (if any)",
      "tabOrder": 9
    },
    {
      "name": "member.number",
      "type": "text",
      "binding": "field:member.number",
      "description": "Member number",
      "tabOrder": 10
    },
    {
      "name": "nomination.signature",
      "type": "signature",
      "binding": "field:nomination.signature",
      "description": "Signature",
      "required": true,
      "tabOrder": 11
    },
    {
      "name": "nomination.date",
      "type": "text",
      "binding": "field:nomination.date",
      "description": "Date signed (DD/MM/YYYY)",
      "required": true,
      "tabOrder": 12
    },
    {
      "name": "employer.dateAccepted",
      "type": "text",
      "binding": "field:employer.dateAccepted",
      "description": "Date the nomination was accepted (DD/MM/YYYY)",
      "tabOrder": 13
    },
    {
      "name": "employer.dateActioned",
      "type": "text",
      "binding": "field:employer.dateActioned",
      "description": "Date the nomination was actioned (DD/MM/YYYY)",
      "tabOrder": 14
    }
  ],
  "output": {
    "printPdf": true,
    "interactivePdf": true,
    "saveIndd": true
