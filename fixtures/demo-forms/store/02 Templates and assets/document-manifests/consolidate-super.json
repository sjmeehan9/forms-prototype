    {
      "name": "account.productName",
      "type": "text",
      "binding": "field:account.productName",
      "description": "Product name",
      "tabOrder": 3
    },
    {
      "name": "member.gender",
      "type": "radio",
      "binding": "field:member.gender:male",
      "description": "Gender: Male",
      "required": true,
      "exportValue": "male",
      "group": "member.gender",
      "tabOrder": 4
    },
    {
      "name": "member.gender",
      "type": "radio",
      "binding": "field:member.gender:female",
