    {
      "name": "account.number",
      "type": "text",
      "binding": "field:account.number",
      "description": "Account number (if known)",
      "tabOrder": 1
    },
    {
      "name": "customer.number",
      "type": "text",
      "binding": "field:customer.number",
      "description": "Customer number (if known)",
      "tabOrder": 2
