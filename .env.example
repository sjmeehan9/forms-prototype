# Copy to .env.local and fill in the Adobe Developer Console values.
# .env.local is ignored by git. Never paste these values into chat or commits.
FRAMEIO_CLIENT_ID=
FRAMEIO_CLIENT_SECRET=
# Must match the Default redirect URI registered in Adobe Developer Console (HTTPS is mandatory, even for localhost).
FRAMEIO_REDIRECT_URI=https://localhost:4319/oauth/callback
# Optional: leave blank and `npm run bootstrap:frameio` will discover them when exactly one exists.
FRAMEIO_ACCOUNT_ID=
FRAMEIO_WORKSPACE_ID=
FRAMEIO_PROJECT_ID=
# frameio | local
STORAGE_MODE=frameio
# folder | metadata (metadata is not implemented in this prototype)
TRIGGER_MODE=folder
# uxp | dry-run | firefly (firefly is a stub)
COMPOSITION_MODE=uxp
POLL_INTERVAL_MS=5000
UXP_JOB_TIMEOUT_MS=120000
# Folder the InDesign panel is granted access to; queue/ and work/ live inside it.
PROTOTYPE_HOME=.prototype
# Optional overrides for the TLS certificate used by the local OAuth callback (defaults live under PROTOTYPE_HOME/tls).
TLS_CERT_FILE=
TLS_KEY_FILE=
